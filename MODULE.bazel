module(name = "skill_bom_cli", version = "0.0.1")
bazel_dep(name = "rules_rust", version = "0.74.0")
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2024", versions = ["1.97.1"])
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")
host_tools = use_extension("@rules_rust//rust:extensions.bzl", "rust_host_tools")
host_tools.host_tools(name = "pinned_rust_host_tools", version = "1.97.1")
use_repo(host_tools, "pinned_rust_host_tools")
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(name = "crates", cargo_lockfile = "//:Cargo.lock", manifests = ["//:Cargo.toml"], host_tools = "@pinned_rust_host_tools", isolated = False)
use_repo(crate, "crates")
